{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wardogs-assets-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-04-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assets.wardogs-artillery.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "wardogs-assets"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://wardogs-artillery.com",
    "DEVELOPMENT_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000",
    "PROTECTED_PREFIX": "/releases/assets-v1/",
    "ENFORCE_SESSIONS": "false",
    "SESSION_LIFETIME_SECONDS": "1200",
    "TURNSTILE_HOSTNAME": "wardogs-artillery.com",
    "TURNSTILE_ACTION": "asset-session",
    "FALLBACK_COUNTRIES": "CN,RU",
    "EDGE_CACHE_SECONDS": "2592000"
  },
  "ratelimits": [
    {
      "name": "SESSION_RATE",
      "namespace_id": "73201",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ASSET_SESSION_RATE",
      "namespace_id": "73202",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    },
    {
      "name": "ASSET_RESTRICTED_RATE",
      "namespace_id": "73203",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "ASSET_IP_RATE",
      "namespace_id": "73204",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    }
  ]
}
